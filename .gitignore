# session-local hook markers
.claude/.edited
.claude/.tested
.claude/settings.local.json

# جذور عمل وكلاء البناء المتوازيين — مساحات مؤقتة لا تُلتزم
.claude/worktrees/

# أسرار الجذر — لا تُرفع أبداً
.env
.env.*

# بيانات وقت التشغيل ونُسخ احتياطية في الجذر — لا تُرفع أبداً
data/

# صادرات اجتماعات تيمز الخام — تحمل رموز وصول ومعرّفات دليل في روابط الصور، لا تُلتزم أبداً
# (النسخة النظيفة تُولَّد بـ platform/scripts/transcript-to-md.mjs وتُودَع وحدها)
*-transcript.html
*meeting-transcript*.html

# صندوق الوارد — ملفات SharePoint/البريد الخام تبقى محلية ولا تُلتزم
platform/docs/inbox/*
!platform/docs/inbox/README.md

# جداول العملاء الخام (بلاغات/طلبات) — تُنزَّل محلياً ولا تُلتزم أبداً
*.xlsx
*.xls
*.csv
