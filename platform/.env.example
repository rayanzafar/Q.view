# ── سند — environment template. Copy to .env and fill for production. ──
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Session secret — REQUIRED in production (boot fails without it). Generate: openssl rand -hex 32
# NOTE: nothing signs anything with it today; sessions are opaque DB-backed tokens. Kept as a
# required var so a production environment is never brought up half-configured. See ADR-0012.
SESSION_SECRET=
# Idle window: how long a session survives with NO activity. It SLIDES — every request pushes it
# forward, so an active user is never logged out mid-work (ADR-0012).
SESSION_TTL_HOURS=12
# Absolute ceiling from login, no matter how active. Bounds a stolen cookie.
SESSION_MAX_DAYS=30
# Write throttle for the sliding touch: at most one UPDATE per session per this many minutes.
SESSION_TOUCH_MINUTES=5

# Database. Leave empty for dev (built-in SQLite). Set for production Postgres:
# DATABASE_URL=postgres://user:pass@host:5432/sanad
DATABASE_URL=
SANAD_DB=./data/sanad.db

# Public URL (used in report/email links)
PLATFORM_URL=https://sanad.os.evcsol.com

# Email. dev='preview' (writes HTML to data/outbox, no network). prod='smtp':
MAIL_TRANSPORT=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sanad Platform <no-reply@evc.com.sa>

# AI assistant — works locally with NO key (heuristic engine). A key upgrades quality.
# Prefer ANTHROPIC_API_KEY (Claude) or set OPENAI_API_KEY. Only redacted context is ever sent.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=

FISCAL_YEAR=2026
